{
  "name": "acuheal-monorepo",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "seed": "pnpm --filter @acuheal/api seed",
    "seed:demo": "pnpm --filter @acuheal/api seed:demo",
    "demo": "pnpm --filter @acuheal/api dev:standalone"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
