# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (Vercel prod + previews + localhost)
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Database (MongoDB Atlas M0 works) ---
MONGODB_URI=mongodb://127.0.0.1:27017/acuheal

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Set to true when web and api are on different domains over https (Vercel + Render)
COOKIE_SECURE=false

# --- Media storage: local (dev) | r2 (Cloudflare R2, S3-compatible) ---
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
# Public URL the API is reachable at (used to build local file URLs)
API_PUBLIC_URL=http://localhost:4000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=acuheal-media
# Public bucket URL or custom domain, e.g. https://media.acuheal.in
R2_PUBLIC_URL=
STORAGE_INCLUDED_GB=30
STORAGE_EXCESS_RATE_INR=50

# --- WhatsApp: console (logs only) | meta (WhatsApp Cloud API) ---
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Integrations ---
# Shared secret the biometric bridge / CSV pusher sends in the x-api-key header
BIOMETRIC_API_KEY=change-me
# Shared secret for external cron (cron-job.org) to trigger jobs over HTTP
JOBS_SECRET=change-me
# Timezone used for reminders, day boundaries and reports
TZ=Asia/Kolkata

# --- Seed ---
SEED_ADMIN_EMAIL=admin@acuheal.local
SEED_ADMIN_PASSWORD=Admin@12345
